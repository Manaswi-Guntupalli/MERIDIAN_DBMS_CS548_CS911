digraph Meridian {
graph [rankdir=LR, newrank=true, compound=true, splines=polyline, nodesep=0.42, ranksep=1.3, pad=0.35, bgcolor="transparent", fontname="Arial", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontcolor="#142B3A", margin=0];
edge [fontname="Arial", fontsize=10, color="#7B8D9D", fontcolor="#445F75", penwidth=1.15, arrowsize=0.75, labeldistance=2.0, labelangle=24];
subgraph cluster_05_fees { label="Fees & payments"; labelloc=t; labeljust=l; fontname="Arial"; fontsize=19; fontcolor="#327D4C"; color="#D5DFE4"; style="rounded,filled"; fillcolor="#F6F9FA"; margin=24;
"Fee" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#327D4C" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Fee</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">KEY</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">ATTRIBUTE</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">PG TYPE</FONT></TD><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">NULL</FONT></TD></TR><TR><TD PORT="id_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#996013" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="id_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="schoolId_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>FK</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">schoolId</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="schoolId_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="studentId_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>FK</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">studentId</FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="studentId_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="title_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">title</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="title_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="amount_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">amount</FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">numeric(12,2)</FONT></TD><TD PORT="amount_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="paid_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">paid</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">numeric(12,2)</FONT></TD><TD PORT="paid_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="dueDate_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">dueDate</FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="dueDate_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="status_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">status</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="status_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="createdAt_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">createdAt</FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">timestamp(3)</FONT></TD><TD PORT="createdAt_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR></TABLE>>];
"Payment" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#327D4C" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Payment</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">KEY</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">ATTRIBUTE</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">PG TYPE</FONT></TD><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">NULL</FONT></TD></TR><TR><TD PORT="id_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#996013" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="id_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="feeId_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>FK</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">feeId</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="feeId_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="amount_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">amount</FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">numeric(12,2)</FONT></TD><TD PORT="amount_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="method_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">method</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="method_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR><TR><TD PORT="reference_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">reference</FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="reference_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#71818D" POINT-SIZE="10">yes</FONT></TD></TR><TR><TD PORT="paidAt_in" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#315F8C" POINT-SIZE="10"><B>-</B></FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13">paidAt</FONT></TD><TD BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">timestamp(3)</FONT></TD><TD PORT="paidAt_out" BGCOLOR="#F4F7F9" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR></TABLE>>];
}
"School" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>School</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">KEY</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">ATTRIBUTE</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">PG TYPE</FONT></TD><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">NULL</FONT></TD></TR><TR><TD PORT="id_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#996013" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="id_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR></TABLE>>];
"Student" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Student</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">KEY</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">ATTRIBUTE</FONT></TD><TD BGCOLOR="#EBF0F3" ALIGN="LEFT"><FONT POINT-SIZE="10">PG TYPE</FONT></TD><TD BGCOLOR="#EBF0F3"><FONT POINT-SIZE="10">NULL</FONT></TD></TR><TR><TD PORT="id_in" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#996013" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#536778" POINT-SIZE="11">text</FONT></TD><TD PORT="id_out" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT COLOR="#354D5C" POINT-SIZE="10">no</FONT></TD></TR></TABLE>>];
"Fee":"id_out":e -> "Payment":"feeId_in":w [id="Payment_feeId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="feeId", tooltip="Payment.feeId -> Fee.id"];
"School":"id_out":e -> "Fee":"schoolId_in":w [id="Fee_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Fee.schoolId -> School.id"];
"Student":"id_out":e -> "Fee":"studentId_in":w [id="Fee_studentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="studentId", tooltip="Fee.studentId -> Student.id"];
}
