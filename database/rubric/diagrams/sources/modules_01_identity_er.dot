digraph Meridian {
graph [rankdir=LR, newrank=true, compound=true, splines=polyline, nodesep=0.42, ranksep=1.3, pad=0.35, bgcolor="transparent", fontname="Arial", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontcolor="#142B3A", margin=0];
edge [fontname="Arial", fontsize=10, color="#7B8D9D", fontcolor="#445F75", penwidth=1.15, arrowsize=0.75, labeldistance=2.0, labelangle=24];
subgraph cluster_01_identity { label="Identity & enrolment"; labelloc=t; labeljust=l; fontname="Arial"; fontsize=19; fontcolor="#0B756A"; color="#D5DFE4"; style="rounded,filled"; fillcolor="#F6F9FA"; margin=24;
"School" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#0B756A" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>School</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">name</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">code</FONT></TD></TR></TABLE>>];
"User" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#0B756A" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>User</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">name</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">role</FONT></TD></TR></TABLE>>];
"Teacher" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#0B756A" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Teacher</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">employeeId</FONT></TD></TR></TABLE>>];
"Student" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#0B756A" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Student</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">admissionNo</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">name</FONT></TD></TR></TABLE>>];
"Parent" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#0B756A" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Parent</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"StudentParent" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#0B756A" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>StudentParent</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
