}
"Class" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Class</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"Class" -> "Student" [id="Student_classId_fkey", dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..N", label="classId", tooltip="Student.classId -> Class.id"];
"Parent" -> "StudentParent" [id="StudentParent_parentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="parentId", tooltip="StudentParent.parentId -> Parent.id"];
"School" -> "Parent" [id="Parent_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Parent.schoolId -> School.id"];
"School" -> "PushDevice" [id="PushDevice_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="PushDevice.schoolId -> School.id"];
"School" -> "Student" [id="Student_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Student.schoolId -> School.id"];
"School" -> "Teacher" [id="Teacher_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Teacher.schoolId -> School.id"];
"School" -> "User" [id="User_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="User.schoolId -> School.id"];
"Student" -> "StudentParent" [id="StudentParent_studentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="studentId", tooltip="StudentParent.studentId -> Student.id"];
"User" -> "Parent" [id="Parent_userId_fkey", dir=both, arrowtail="teetee", arrowhead="teeodot", taillabel="1", headlabel="0..1", label="userId", tooltip="Parent.userId -> User.id"];
"User" -> "PushDevice" [id="PushDevice_userId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="userId", tooltip="PushDevice.userId -> User.id"];
"User" -> "Student" [id="Student_userId_fkey", dir=both, arrowtail="teeodot", arrowhead="teeodot", taillabel="0..1", headlabel="0..1", label="userId", tooltip="Student.userId -> User.id"];
"User" -> "Teacher" [id="Teacher_userId_fkey", dir=both, arrowtail="teetee", arrowhead="teeodot", taillabel="1", headlabel="0..1", label="userId", tooltip="Teacher.userId -> User.id"];
