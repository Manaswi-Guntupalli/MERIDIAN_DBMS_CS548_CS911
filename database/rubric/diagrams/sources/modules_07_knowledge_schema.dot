digraph Meridian {
graph [rankdir=LR, newrank=true, compound=true, splines=polyline, nodesep=0.42, ranksep=1.3, pad=0.35, bgcolor="transparent", fontname="Arial", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontcolor="#142B3A", margin=0];
edge [fontname="Arial", fontsize=10, color="#7B8D9D", fontcolor="#445F75", penwidth=1.15, arrowsize=0.75, labeldistance=2.0, labelangle=24];
subgraph cluster_07_knowledge { label="Knowledge, analytics & audit"; labelloc=t; labeljust=l; fontname="Arial"; fontsize=19; fontcolor="#4B6D88"; color="#D5DFE4"; style="rounded,filled"; fillcolor="#F6F9FA"; margin=24;
