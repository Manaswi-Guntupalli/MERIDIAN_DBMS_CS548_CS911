digraph Meridian {
graph [rankdir=LR, newrank=true, compound=true, splines=polyline, nodesep=0.42, ranksep=1.3, pad=0.35, bgcolor="transparent", fontname="Arial", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontcolor="#142B3A", margin=0];
edge [fontname="Arial", fontsize=10, color="#7B8D9D", fontcolor="#445F75", penwidth=1.15, arrowsize=0.75, labeldistance=2.0, labelangle=24];
subgraph cluster_05_fees { label="Fees & payments"; labelloc=t; labeljust=l; fontname="Arial"; fontsize=19; fontcolor="#327D4C"; color="#D5DFE4"; style="rounded,filled"; fillcolor="#F6F9FA"; margin=24;
"Fee" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#327D4C" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Fee</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">title</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">amount</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">paid</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">status</FONT></TD></TR></TABLE>>];
"Payment" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#327D4C" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Payment</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">amount</FONT></TD></TR></TABLE>>];
}
"School" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>School</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"Student" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Student</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"Fee" -> "Payment" [id="Payment_feeId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="feeId", tooltip="Payment.feeId -> Fee.id"];
"School" -> "Fee" [id="Fee_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Fee.schoolId -> School.id"];
"Student" -> "Fee" [id="Fee_studentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="studentId", tooltip="Fee.studentId -> Student.id"];
}
