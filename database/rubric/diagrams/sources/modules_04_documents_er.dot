digraph Meridian {
graph [rankdir=LR, newrank=true, compound=true, splines=polyline, nodesep=0.42, ranksep=1.3, pad=0.35, bgcolor="transparent", fontname="Arial", outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontcolor="#142B3A", margin=0];
edge [fontname="Arial", fontsize=10, color="#7B8D9D", fontcolor="#445F75", penwidth=1.15, arrowsize=0.75, labeldistance=2.0, labelangle=24];
subgraph cluster_04_documents { label="Document intake & extraction"; labelloc=t; labeljust=l; fontname="Arial"; fontsize=19; fontcolor="#B26028"; color="#D5DFE4"; style="rounded,filled"; fillcolor="#F6F9FA"; margin=24;
"Document" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#B26028" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Document</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">status</FONT></TD></TR></TABLE>>];
"DocumentPage" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#B26028" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>DocumentPage</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"ExtractedField" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#B26028" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>ExtractedField</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">status</FONT></TD></TR></TABLE>>];
"DocumentInsight" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#B26028" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>DocumentInsight</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"DocumentActivity" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#B26028" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>DocumentActivity</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
}
"School" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>School</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"Document" -> "DocumentActivity" [id="DocumentActivity_documentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="documentId", tooltip="DocumentActivity.documentId -> Document.id"];
"Document" -> "DocumentInsight" [id="DocumentInsight_documentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="documentId", tooltip="DocumentInsight.documentId -> Document.id"];
"Document" -> "DocumentPage" [id="DocumentPage_documentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="documentId", tooltip="DocumentPage.documentId -> Document.id"];
"Document" -> "ExtractedField" [id="ExtractedField_documentId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="documentId", tooltip="ExtractedField.documentId -> Document.id"];
"School" -> "Document" [id="Document_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Document.schoolId -> School.id"];
}
