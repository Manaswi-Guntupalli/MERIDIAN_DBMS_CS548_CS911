digraph Chen {
graph [rankdir=LR, newrank=true, compound=true, splines=polyline, nodesep=0.18, ranksep=0.8, pad=0.4, bgcolor="transparent", outputorder=edgesfirst, fontname="Arial"];
node [fontname="Arial",fontsize=13,fontcolor="#152A38"];
edge [fontname="Arial",fontsize=13,fontcolor="#D73232",color="#4A5966",penwidth=0.8,arrowsize=0.6,dir=none];
subgraph "cluster_attributes_Fee" { style=invis; margin=12; label="";
"ent_Fee" [shape=box,style=filled,fillcolor="#DDE9FF",color="#3B72FF",penwidth=1.2,width=1.7,height=0.55,label="Fee"];
{rank=same;
"attr_Fee.id" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label=<<U>id</U>>];
"attr_Fee.amount" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label="amount"];
"attr_Fee.dueDate" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label="dueDate"];
"attr_Fee.createdAt" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label="createdAt"];
}
"attr_Fee.id" -> "ent_Fee" [color="#929EA7",weight=3];
"attr_Fee.amount" -> "ent_Fee" [color="#929EA7",weight=3];
"attr_Fee.dueDate" -> "ent_Fee" [color="#929EA7",weight=3];
"attr_Fee.createdAt" -> "ent_Fee" [color="#929EA7",weight=3];
{rank=same;
"attr_Fee.title" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label="title"];
"attr_Fee.paid" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label="paid"];
"attr_Fee.status" [shape=ellipse,style=filled,fillcolor="#F1FCF8",color="#0C9C7B",penwidth=0.85,margin="0.12,0.07",label="status"];
}
"ent_Fee" -> "attr_Fee.title" [color="#929EA7",weight=3];
"ent_Fee" -> "attr_Fee.paid" [color="#929EA7",weight=3];
"ent_Fee" -> "attr_Fee.status" [color="#929EA7",weight=3];
}
subgraph "cluster_attributes_Payment" { style=invis; margin=12; label="";
