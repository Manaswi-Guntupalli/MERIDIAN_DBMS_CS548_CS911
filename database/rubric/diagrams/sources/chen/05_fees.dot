}
"attr_Student.id" -> "ent_Student" [color="#929EA7",weight=3];
}
"rel_Payment_feeId_fkey" [shape=diamond,style=filled,fillcolor="#FFF2DB",color="#F47B20",penwidth=1.1,fontsize=12,margin="0.08,0.05",label="Pays fee\n[feeId]"];
"ent_Fee" -> "rel_Payment_feeId_fkey" [id="Payment_feeId_fkey_parent",label="1",minlen=1,weight=2];
"rel_Payment_feeId_fkey" -> "ent_Payment" [id="Payment_feeId_fkey_child",label="N",minlen=1,weight=2,color="#4A5966:#4A5966"];
"rel_Fee_schoolId_fkey" [shape=diamond,style=filled,fillcolor="#FFF2DB",color="#F47B20",penwidth=1.1,fontsize=12,margin="0.08,0.05",label="Belongs to school\n[schoolId]"];
"ent_School" -> "rel_Fee_schoolId_fkey" [id="Fee_schoolId_fkey_parent",label="1",minlen=1,weight=2];
"rel_Fee_schoolId_fkey" -> "ent_Fee" [id="Fee_schoolId_fkey_child",label="N",minlen=1,weight=2,color="#4A5966:#4A5966"];
"rel_Fee_studentId_fkey" [shape=diamond,style=filled,fillcolor="#FFF2DB",color="#F47B20",penwidth=1.1,fontsize=12,margin="0.08,0.05",label="For student\n[studentId]"];
