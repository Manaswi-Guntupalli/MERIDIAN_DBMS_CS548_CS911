"Timetable" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#365DAD" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Timetable</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">name</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">status</FONT></TD></TR></TABLE>>];
"TimetableSlot" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#365DAD" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>TimetableSlot</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"StaffAbsence" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#365DAD" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>StaffAbsence</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F4F7F9" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#142B3A" POINT-SIZE="13">date</FONT></TD></TR></TABLE>>];
"Substitution" [label=<<TABLE BORDER="1" COLOR="#CBD6DC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#365DAD" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Substitution</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
}
"School" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>School</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"Teacher" [label=<<TABLE BORDER="1" COLOR="#B9C5CD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="4" BGCOLOR="#71818D" ALIGN="LEFT" CELLPADDING="11"><FONT COLOR="white" POINT-SIZE="17"><B>Teacher</B></FONT><FONT COLOR="white" POINT-SIZE="10">  [external]</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#9E6715" POINT-SIZE="13"><B>PK  id</B></FONT></TD></TR></TABLE>>];
"Building" -> "Room" [id="Room_buildingId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="buildingId", tooltip="Room.buildingId -> Building.id"];
"Class" -> "ClassSubjectPlan" [id="ClassSubjectPlan_classId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="classId", tooltip="ClassSubjectPlan.classId -> Class.id"];
"Class" -> "TimetableSlot" [id="TimetableSlot_classId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="classId", tooltip="TimetableSlot.classId -> Class.id"];
"Room" -> "Class" [id="Class_roomId_fkey", dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..N", label="roomId", tooltip="Class.roomId -> Room.id"];
"Room" -> "TimetableSlot" [id="TimetableSlot_roomId_fkey", dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..N", label="roomId", tooltip="TimetableSlot.roomId -> Room.id"];
"School" -> "AcademicConfig" [id="AcademicConfig_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="teeodot", taillabel="1", headlabel="0..1", label="schoolId", tooltip="AcademicConfig.schoolId -> School.id"];
"School" -> "Building" [id="Building_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Building.schoolId -> School.id"];
"School" -> "Class" [id="Class_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Class.schoolId -> School.id"];
"School" -> "Subject" [id="Subject_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Subject.schoolId -> School.id"];
"School" -> "Timetable" [id="Timetable_schoolId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="schoolId", tooltip="Timetable.schoolId -> School.id"];
"StaffAbsence" -> "Substitution" [id="Substitution_absenceId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="absenceId", tooltip="Substitution.absenceId -> StaffAbsence.id"];
"Subject" -> "ClassSubjectPlan" [id="ClassSubjectPlan_subjectId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="subjectId", tooltip="ClassSubjectPlan.subjectId -> Subject.id"];
"Subject" -> "TimetableSlot" [id="TimetableSlot_subjectId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="subjectId", tooltip="TimetableSlot.subjectId -> Subject.id"];
"Teacher" -> "Class" [id="Class_classTeacherId_fkey", dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..N", label="classTeacherId", tooltip="Class.classTeacherId -> Teacher.id"];
"Teacher" -> "StaffAbsence" [id="StaffAbsence_teacherId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="teacherId", tooltip="StaffAbsence.teacherId -> Teacher.id"];
"Teacher" -> "Substitution" [id="Substitution_subTeacherId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="subTeacherId", tooltip="Substitution.subTeacherId -> Teacher.id"];
