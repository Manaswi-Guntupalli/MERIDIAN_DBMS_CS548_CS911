"Timetable" -> "TimetableSlot" [id="TimetableSlot_timetableId_fkey", dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="timetableId", tooltip="TimetableSlot.timetableId -> Timetable.id"];
