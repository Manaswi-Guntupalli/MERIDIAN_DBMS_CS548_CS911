"AttendanceSession" -> "AttendanceEvent" [id="AttendanceEvent_sessionId_fkey", dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..N", label="sessionId", tooltip="AttendanceEvent.sessionId -> AttendanceSession.id"];
