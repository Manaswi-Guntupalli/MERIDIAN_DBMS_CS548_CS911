# ---- Meridian server config ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL + pgvector. Copy .env.example to .env at the repo root too.
DATABASE_URL="postgresql://meridian:change-this-local-password@localhost:5432/meridian?schema=public"
TEST_DATABASE_URL="postgresql://meridian:change-this-local-password@localhost:5432/meridian_test?schema=public"
# Direct WebSocket origin; Next rewrites support HTTP polling.
# Set NEXT_PUBLIC_SOCKET_ORIGIN in client/.env.local for remote deployments.

# Auth
JWT_SECRET=change-me-in-production-meridian-trust-first
JWT_EXPIRES_IN=7d

# OpenAI (optional): npm run configure:openai from the repo root.
# Shared by the API and Python intelligence service; restart both after changes.
# Copilot has a data-grounded fallback; notice drafting
# requires a configured model. Manual notices remain available without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Python intelligence engine (FastAPI). Start it with `npm run intelligence`.
# The dashboard shows an explicit offline state when unreachable.
INTELLIGENCE_URL=http://localhost:8010
# Optional separate PostgreSQL read-only account for the Python engine.
# Otherwise it uses DATABASE_URL from this file.
INTELLIGENCE_DATABASE_URL=

# Python face service (FastAPI, InsightFace). Turns camera frames into 512-D
# embeddings; Node keeps all matching + DB access. Start it with
# `npm run faceservice`. Down → the kiosk shows an explicit offline state.
FACE_SERVICE_URL=http://localhost:8020

# School calendar / demo controls
SCHOOL_TIMEZONE=Asia/Kolkata
ENABLE_ATTENDANCE_SIMULATOR=false

# Optional real delivery. Requests stay DISABLED until each channel is configured.
# Twilio requires an authorized sender and E.164 recipient numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Absolute path to a private Firebase service-account JSON file; never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Preserve this key with document-storage backups. Changing it makes encrypted
# originals/previews unreadable. configure-local generates an independent key.
LUMEN_STORAGE_KEY=
LUMEN_STORAGE_DIR=
# Leave disabled unless this directory belongs exclusively to this database.
LUMEN_PURGE_ORPHANS=false
